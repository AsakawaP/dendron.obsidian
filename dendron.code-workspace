{
  "folders": [
/**
 * ;;; Root directory should be added to the bottom of `folders` list.
 * ;;; Otherwise, Dendron may fail to start.
 * Dendron indexes vaults defined in `dendron.yml` automatically,
 * even the folders aren't included in Dendron workspace.
 * But only folders included are discoverable in VSCode global search.
 */
    {
      "path": "notes",
      "name": "dendron.obsidian"
    },
    // {
    //     "path": "dependencies/github.com/USERNAME/VAULT_NAME/notes",
    //     "name": "remote vaults"
    // },
    // {
    //     "path": "dependencies/localhost/VAULT_NAME/notes",
    //     "name": "local vaults"
    // },
    {
      "path": ".",
      "name": "rootDir"
    },
  ],
  "settings": {
    /* Dendron default settings */
    "dendron.rootDir": ".",
    "files.autoSave": "onFocusChange",
    "pasteImage.path": "${currentFileDir}/assets/images",
  /**
   * ;;; The prefix "/" in image paths, which means the absolute path "root",
   * ;;; is necessary for Dendron publishing.
   * If this vault is not intended to be published,
   * or needs to be compatible with Obsidian,
   * remove the prefix from Markdown links to use relative paths instead.
   */
    "pasteImage.prefix": "/",
    "markdown-preview-enhanced.enableWikiLinkSyntax": true,
    "markdown-preview-enhanced.wikiLinkFileExtension": ".md",
    "editor.snippetSuggestions": "inline",
    "editor.suggest.snippetsPreventQuickSuggestions": false,
    "editor.suggest.showSnippets": true,
    "editor.tabCompletion": "on",
    "dendron.enableSelfContainedVaultWorkspace": true,

    /* VSCode Git settings */
    // Detect $GIT_DIR of the main repository automatically
    "git.openRepositoryInParentFolders": "always",
    "git.repositoryScanIgnoredFolders": [
      "seeds",
      "node_modules",
    ],

    /* Markdown */
    "[markdown]": {
      "editor.renderWhitespace": "boundary",
    },

    /* Automation */
    "auto-run-command.rules": [
      {
        // Activate Dendron Tree-View at startup
        "condition": "always",
        "command": "workbench.view.extension.dendron-view",
        "message": "Activate Dendron TreeView"
      }
    ],

    /* Macros */
    "multiCommand.commands": [
      {
        "command": "multiCommand.MDThematicBreak",
        "label": "Markdown: Thematic Break",
        "description": "Insert `***` Thematic Break",
        "sequence": [
          {
            "command": "paste",
            "args": { "text": "\n\n***\n\n" }
          }
        ]
      },
      {
        "command": "multiCommand.MDHardBreak",
        "label": "Markdown: Hard Break",
        "description": "Insert `  \n` Hard Line Break",
        "sequence": [
          {
            "command": "paste",
            "args": { "text": "  \n" }
          }
        ]
      },
    ],
  },
  "extensions": {
    "recommendations": [
      /* Dendron */
      "dendron.dendron",
      "dendron.dendron-paste-image",
      "dendron.dendron-markdown-shortcuts",
      "redhat.vscode-yaml",
      "webplan-pro.dendron-keybindings",
      "dendron.adjust-heading-level",

      /* Highly Recommended */
      "ryuta46.multi-command",
      "gabrielgrinberg.auto-run-command",
      "gruntfuggly.todo-tree",
      "oderwat.indent-rainbow",

      /* Markdown */
      "davidanson.vscode-markdownlint",
      "yzhang.markdown-all-in-one",
      "jebbs.markdown-extended",
      "iiwenwen.markdown-footnote",
      "takumii.markdowntable",
      "cescript.markdown-formula",

      /* CJK characters */
      "huacnlee.autocorrect",
      "geezmolycos.vscode-hanzi-counter",
    ],
    "unwantedRecommendations": [
      "dendron.dendron-markdown-links",
      "dendron.dendron-markdown-notes",
      "dendron.dendron-markdown-preview-enhanced",
      "shd101wyy.markdown-preview-enhanced",
      "kortina.vscode-markdown-notes",
      "mushan.vscode-paste-image"
    ]
  }
}